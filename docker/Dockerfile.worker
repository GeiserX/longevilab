# Worker Dockerfile - for background job processing
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

# Trust store without the compromised eMudhra (emSign) intermediates. Node's
# bundled roots still trust them, so read the patched Alpine bundle instead.
RUN apk update && apk upgrade --no-cache ca-certificates-bundle && rm -rf /var/cache/apk/* \
    && [ "$(apk info -v | sed -n 's/^ca-certificates-bundle-\([0-9]*\)-.*/\1/p')" -ge 20261020 ]
ENV NODE_OPTIONS=--use-openssl-ca

# Install OCR dependencies (Tesseract + poppler for pdftoppm)
RUN apk add --no-cache \
  tesseract-ocr \
  tesseract-ocr-data-eng \
  tesseract-ocr-data-spa \
  poppler-utils

# Install pnpm for every user. A corepack shim only caches it for root, so as
# `worker` it fetched the latest pnpm at start, and pnpm 12 refuses the
# pnpm 10 node_modules.
RUN npm install -g pnpm@10

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install all dependencies (including dev for tsx)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Create uploads directory with proper permissions
RUN mkdir -p /app/uploads && chown -R worker:nodejs /app/uploads

USER worker

CMD ["pnpm", "worker"]
